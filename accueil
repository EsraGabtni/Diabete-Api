<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediLens — Plateforme d'Intelligence Artificielle Médicale</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        medical: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6',
                            600: '#0d9488',
                            800: '#115e59',
                            900: '#134e4a',
                            dark: '#0b1329',
                            card: '#131e3a',
                            accent: '#38bdf8'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #070c1e; color: #f8fafc; }
        .glass-panel { background: rgba(19, 30, 58, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .glass-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .glass-card:hover { transform: translateY(-6px); border-color: rgba(56, 189, 248, 0.4); box-shadow: 0 20px 30px -10px rgba(14, 165, 233, 0.15); }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- En-tête / Barre de Navigation -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="scrollToSection('hero')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-500 to-cyan-400 flex items-center justify-center text-slate-950 font-bold text-xl shadow-lg shadow-teal-500/20">
                    <i class="fa-solid font-black fa-stethoscope"></i>
                </div>
                <div>
                    <span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-cyan-400">MediLens</span>
                    <span class="block text-xs font-medium text-teal-400 tracking-wider">PORTAIL CLINIQUE IA</span>
                </div>
            </div>

            <!-- Liens de navigation rapide -->
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-300">
                <button onclick="scrollToSection('hero')" class="hover:text-cyan-400 transition-colors">Accueil</button>
                <button onclick="scrollToSection('models-section')" class="hover:text-cyan-400 transition-colors">Nos Modèles</button>
                <button onclick="scrollToSection('live-demo')" class="hover:text-cyan-400 transition-colors">Démonstrations</button>
            </nav>

            <!-- Statut des API -->
            <div class="flex items-center space-x-2 text-xs bg-slate-900/80 px-3 py-1.5 rounded-full border border-slate-800">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="text-slate-300">Render APIs Live</span>
            </div>
        </div>
    </header>

    <!-- SECTION 1: HERO / LANDING PAGE -->
    <section id="hero" class="relative py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <div class="text-center max-w-3xl mx-auto space-y-6">
            <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs font-semibold tracking-wide uppercase">
                <i class="fa-solid fa-microchip"></i>
                <span>Assistants Décisionnels Médicaux</span>
            </div>
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white">
                Intelligence Artificielle pour l'Analyse <span class="bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-cyan-400">Hospitalière</span>
            </h1>
            <p class="text-slate-400 text-lg sm:text-xl leading-relaxed">
                Centralisez vos prédictions cliniques au même endroit : risque de diabète, durée de séjour et estimation des actes médicaux.
            </p>
        </div>

        <!-- SECTION 2: CARTES CLIQUABLES VERS CHAQUE MODÈLE -->
        <div id="models-section" class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <!-- Carte 1 : Diabète -->
            <div onclick="selectModel('diabete')" class="glass-card glass-panel rounded-2xl p-6 cursor-pointer flex flex-col justify-between group">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-teal-500/10 text-teal-400 border border-teal-500/20 flex items-center justify-center text-xl mb-5 group-hover:bg-teal-500 group-hover:text-slate-950 transition-all">
                        <i class="fa-solid fa-droplet"></i>
                    </div>
                    <span class="text-xs font-semibold text-teal-400 uppercase tracking-wider">Modèle ML #1</span>
                    <h3 class="text-xl font-bold text-white mt-1 group-hover:text-cyan-300 transition-colors">Prédiction du Diabète</h3>
                    <p class="text-slate-400 text-sm mt-3 leading-relaxed">
                        Analyse les facteurs démographiques et biométriques pour évaluer le risque individuel de développer un diabète.
                    </p>
                </div>
                <div class="mt-8 pt-4 border-t border-slate-800 flex items-center justify-between text-sm text-teal-400 font-semibold">
                    <span>Accéder à l'outil</span>
                    <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </div>
            </div>

            <!-- Carte 2 : Durée de Séjour (API 2) -->
            <div onclick="selectModel('duree')" class="glass-card glass-panel rounded-2xl p-6 cursor-pointer flex flex-col justify-between group">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center text-xl mb-5 group-hover:bg-cyan-400 group-hover:text-slate-950 transition-all">
                        <i class="fa-solid fa-hospital-user"></i>
                    </div>
                    <span class="text-xs font-semibold text-cyan-400 uppercase tracking-wider">Modèle ML #2</span>
                    <h3 class="text-xl font-bold text-white mt-1 group-hover:text-cyan-300 transition-colors">Durée de Séjour</h3>
                    <p class="text-slate-400 text-sm mt-3 leading-relaxed">
                        Estime la durée totale d'hospitalisation d'un patient pour optimiser la gestion des lits et des ressources hospitalières.
                    </p>
                </div>
                <div class="mt-8 pt-4 border-t border-slate-800 flex items-center justify-between text-sm text-cyan-400 font-semibold">
                    <span>Accéder à l'outil</span>
                    <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </div>
            </div>

            <!-- Carte 3 : Procédures Médicales (API 2 - URL principale) -->
            <div onclick="selectModel('procedures')" class="glass-card glass-panel rounded-2xl p-6 cursor-pointer flex flex-col justify-between group">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center text-xl mb-5 group-hover:bg-blue-500 group-hover:text-slate-950 transition-all">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <span class="text-xs font-semibold text-blue-400 uppercase tracking-wider">Modèle ML #3</span>
                    <h3 class="text-xl font-bold text-white mt-1 group-hover:text-cyan-300 transition-colors">Nombre de Procédures</h3>
                    <p class="text-slate-400 text-sm mt-3 leading-relaxed">
                        Modèle de Gradient Boosting évaluant le nombre d'actes médicaux (MAE ≈ ±0.948) via <code class="text-xs text-blue-300">modele-procedures-api.onrender.com</code>[cite: 2].
                    </p>
                </div>
                <div class="mt-8 pt-4 border-t border-slate-800 flex items-center justify-between text-sm text-blue-400 font-semibold">
                    <span>Accéder à l'outil</span>
